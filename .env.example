# Copy to apps/web/.env.local for local development. Never commit real values.

# Public site address (used for canonical links and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Booking master switch. OFF by default.
# Turning this on alone does NOT open booking. Every category and location also needs
# status = available, an enabled booking mode, and a complete readiness record
# with two distinct approvers.
BOOKING_ENABLED=false

# Reserved for the SOS milestone. Not read by Milestone 1 code.
# SOS public activation stays off until staffed operations are verified.
SOS_PUBLIC_ENABLED=false

# PostgreSQL connection for migrations and seeding (Milestone 2 onward).
# Milestone 1 pages read the in-repo sample data and do not need a database.
DATABASE_URL=

# Allows sample seed data. Refused when NODE_ENV=production unless set to true.
ALLOW_SAMPLE_SEED=false
